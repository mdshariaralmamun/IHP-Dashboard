# Copy this file to .env and fill in real values. docker-compose.yml reads
# .env automatically and passes these variables to the backend and frontend
# containers (the apps themselves do not read .env directly).
#
# NEVER commit the real .env file. .env is in .gitignore.
#
# If a key here is ever exposed (e.g. in a tracked file, public repo, or
# shared screenshot), rotate it immediately at the provider's dashboard:
#   - OpenRouter:     https://openrouter.ai -> Keys
#   - Anthropic:      https://console.anthropic.com -> Settings
# and update this file with the NEW value. The pre-commit hook in .githooks/
# scans for sk-or-* and sk-ant-* patterns and will block a new leak.

# --- Database (Postgres 16, container `db`) ---
# Password for the `ihp` database user. Compose builds DATABASE_URL from it.
DB_PASSWORD=change-me-strong-password

# --- Backend security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-hex-chars

# Initial admin account for the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Outgoing mail (optional; leave commented to disable) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# --- Cloudflare Zero Trust tunnel (optional) ---
# Only needed if you use the `cloudflared` service (profile `tunnel`) instead
# of an existing cloudflared on the VPS. See comments in docker-compose.yml.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- LLM provider keys (used by Claude Code shells; not by the backend) ---
# The IHP backend reads AI_BASE_URL / AI_CHAT_MODEL / AI_EMBED_MODEL below
# (defaults to a local Ollama). The keys here are for the Claude Code CLI
# that wraps the harness — they do not need to be present for the app to run.
#
# Rotate the OpenRouter key at https://openrouter.ai -> Keys.
# Rotate the Anthropic key at https://console.anthropic.com -> Settings.
OPENROUTER_API_KEY=sk-or-REPLACE_ME
ANTHROPIC_AUTH_TOKEN=sk-ant-REPLACE_ME

# --- AI / RAG settings (consumed by backend/app/core/config.py) ---
# Base URL of the Ollama-compatible endpoint. Local default is fine for dev;
# point at a remote OpenAI-compatible API in production.
AI_BASE_URL=http://localhost:11434
AI_CHAT_MODEL=llama3.2:3b
AI_EMBED_MODEL=nomic-embed-text
# Context window requested from Ollama. Ollama's own default (2048 tokens) is
# smaller than the assistant's live-context block, and it then rejects the
# request with HTTP 400. 8192 fits the context plus a short conversation.
AI_NUM_CTX=8192
# Reserved for future cloud providers. Leave empty for local Ollama.
AI_API_KEY=

# --- Engineering data ingestion (Phase 2, Task 1) ---
# Root directory the watcher monitors. Can be a Windows path on dev
# machines (e.g. E:\ENGINEERING_DATA) or a POSIX path on the VPS — both
# work because the watcher uses pathlib. If the directory does not exist
# yet, the watcher logs and retries without crashing the app.
ENGINEERING_DATA_ROOT=E:\ENGINEERING_DATA
